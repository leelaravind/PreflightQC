{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://preflightqc.local/schema/preset.schema.json",
  "title": "PreflightQC preset document",
  "description": "A versioned, source-traceable rule set for one delivery surface. Deliberately carries no remote $ref: schema resolution must never touch the network.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preset_id",
    "platform",
    "display_name",
    "description",
    "ruleset_version",
    "last_verified_date",
    "sources",
    "rules"
  ],
  "properties": {
    "preset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 3,
      "maxLength": 64
    },
    "platform": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "enum": ["shipped", "custom"] },
    "ruleset_version": { "type": "string", "minLength": 1 },
    "last_verified_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "byte_convention": { "type": "string" },
    "caveats": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "metadata": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "title", "url", "access_date", "confidence"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "access_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "operator"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/definitions/operatorName" },
        "expected": {},
        "tolerance": { "type": "number", "minimum": 0 },
        "relative_tolerance": { "type": "boolean" }
      }
    },
    "operatorName": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "in",
        "not_in",
        "range",
        "lt",
        "lte",
        "gt",
        "gte",
        "present",
        "absent",
        "matches",
        "constant_only"
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "property",
        "operator",
        "classification",
        "severity",
        "explanation",
        "source_ref",
        "confidence",
        "last_verified_date"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.]+$",
          "minLength": 3,
          "maxLength": 96
        },
        "property": { "type": "string", "minLength": 1 },
        "operator": { "$ref": "#/definitions/operatorName" },
        "expected": {},
        "tolerance": { "type": "number", "minimum": 0 },
        "relative_tolerance": { "type": "boolean" },
        "classification": {
          "type": "string",
          "enum": [
            "HARD_REQUIREMENT",
            "DOCUMENTED_LIMIT",
            "RECOMMENDATION",
            "BEST_PRACTICE",
            "ELIGIBILITY",
            "UNKNOWN"
          ]
        },
        "severity": { "type": "string", "enum": ["FAIL", "WARN", "INFO", "UNKNOWN"] },
        "applies_when": { "type": "array", "items": { "$ref": "#/definitions/guard" } },
        "explanation": { "type": "string", "minLength": 1 },
        "message_pass": { "type": "string" },
        "message_fail": { "type": "string" },
        "note": { "type": "string" },
        "source_ref": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "last_verified_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "enabled": { "type": "boolean" },
        "measurable_offline": { "type": "boolean" }
      }
    }
  }
}
