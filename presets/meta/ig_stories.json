{
  "preset_id": "ig_stories",
  "platform": "Meta / Instagram",
  "display_name": "Instagram Stories",
  "description": "Instagram Stories published through the Content Publishing API. Same codec and container envelope as Reels, but with a much tighter duration and file-size ceiling.",
  "origin": "shipped",
  "ruleset_version": "2026-08-09.1",
  "last_verified_date": "2026-08-09",
  "byte_convention": "Decimal bytes (1 MB = 1,000,000). Meta does not state binary or decimal; the decimal reading is the conservative one for a ceiling.",
  "caveats": [
    "These rules are scoped to organic Story publishing through the API. Paid Stories placements have a different, much wider envelope (1 s to 60 min, up to 4 GB) and are not covered by this preset.",
    "The aspect-ratio lower bound here is 0.1:1, an order of magnitude different from the Reels bound of 0.01:1 in the same source document. Both are preserved verbatim.",
    "Meta publishes no audio loudness target and no HDR/colour-space input requirement."
  ],
  "sources": [
    {
      "source_ref": "M-S2",
      "title": "IG User Media reference (Story Video Specifications), Meta for Developers",
      "url": "https://developers.facebook.com/docs/instagram-platform/instagram-graph-api/reference/ig-user/media/",
      "access_date": "2026-08-09",
      "confidence": "HIGH"
    },
    {
      "source_ref": "M-S6",
      "title": "Ads Guide, Instagram Stories video (Awareness)",
      "url": "https://www.facebook.com/business/ads-guide/update/video/instagram-story",
      "access_date": "2026-08-09",
      "confidence": "MEDIUM"
    }
  ],
  "rules": [
    {
      "rule_id": "ig_stories.container",
      "property": "container.format",
      "operator": "in",
      "expected": ["mov", "mp4"],
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "The Content Publishing API accepts MOV or MP4 (MPEG-4 Part 14) containers only.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.video_codec",
      "property": "video.codec",
      "operator": "in",
      "expected": ["h264", "hevc"],
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "The video track must be encoded with HEVC or H.264.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.scan_type",
      "property": "video.scan_type",
      "operator": "eq",
      "expected": "progressive",
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "The video must be progressive.",
      "note": "Scan type is read from container flags rather than from the picture.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.chroma_subsampling",
      "property": "video.chroma_subsampling",
      "operator": "eq",
      "expected": "4:2:0",
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Chroma subsampling must be 4:2:0.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.frame_rate",
      "property": "video.frame_rate",
      "operator": "range",
      "expected": { "min": 23, "max": 60 },
      "tolerance": 0.01,
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Frame rate must be between 23 and 60 FPS.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.max_width",
      "property": "video.display_width",
      "operator": "lte",
      "expected": 1920,
      "classification": "DOCUMENTED_LIMIT",
      "severity": "FAIL",
      "explanation": "Maximum 1920 horizontal pixels.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.aspect_ratio_range",
      "property": "video.display_aspect_ratio",
      "operator": "range",
      "expected": { "min": 0.1, "max": 10.0 },
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Aspect ratio must be between 0.1:1 and 10:1.",
      "note": "This lower bound differs from the Reels bound of 0.01:1 in the same source document. Both are preserved as published.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.aspect_ratio_recommended",
      "property": "video.display_aspect_ratio",
      "operator": "eq",
      "expected": 0.5625,
      "tolerance": 0.01,
      "classification": "RECOMMENDATION",
      "severity": "WARN",
      "explanation": "A 9:16 aspect ratio is recommended for Stories.",
      "message_fail": "This is a recommendation, not an upload requirement.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.video_bitrate",
      "property": "video.bitrate",
      "operator": "lte",
      "expected": 25000000,
      "classification": "DOCUMENTED_LIMIT",
      "severity": "FAIL",
      "explanation": "Video bitrate must not exceed 25 Mbps (VBR).",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.duration",
      "property": "file.duration_seconds",
      "operator": "range",
      "expected": { "min": 3, "max": 60 },
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Duration must be at least 3 seconds and at most 60 seconds.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.file_size",
      "property": "file.size_bytes",
      "operator": "lte",
      "expected": 100000000,
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Maximum file size is 100 MB.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.audio_codec",
      "property": "audio.codec",
      "operator": "in",
      "expected": ["aac"],
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Where an audio track is present it must be AAC.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.audio_sample_rate",
      "property": "audio.sample_rate",
      "operator": "lte",
      "expected": 48000,
      "classification": "DOCUMENTED_LIMIT",
      "severity": "FAIL",
      "explanation": "Audio sample rate must not exceed 48 kHz.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.audio_channels",
      "property": "audio.channels",
      "operator": "range",
      "expected": { "min": 1, "max": 2 },
      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "Audio must be mono or stereo (1 or 2 channels).",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
      "rule_id": "ig_stories.audio_bitrate",
      "property": "audio.bitrate",
      "operator": "gte",
      "expected": 128000,
      "classification": "RECOMMENDATION",
      "severity": "WARN",
      "explanation": "An audio bitrate of 128 kbps is recommended.",
      "message_fail": "This is a recommendation. A lower audio bitrate does not prevent publishing.",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
