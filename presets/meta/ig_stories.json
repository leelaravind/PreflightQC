      "classification": "HARD_REQUIREMENT",
      "severity": "FAIL",
      "explanation": "The moov atom must be at the front of the file (fast start).",
      "source_ref": "M-S2",
      "confidence": "HIGH",
      "last_verified_date": "2026-08-09"
    },
    {
