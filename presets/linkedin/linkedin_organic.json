{
  "preset_id": "linkedin_organic",
  "platform": "LinkedIn",
  "display_name": "LinkedIn — Organic (Pages / native video)",
  "description": "Native video posted organically to a LinkedIn Page. A wide envelope with an unusual container list: AVI, QuickTime and MOV are explicitly no longer supported.",
  "origin": "shipped",
  "ruleset_version": "2026-08-09.1",
  "last_verified_date": "2026-08-09",
  "byte_convention": "Decimal bytes (500 MB = 500,000,000; 5 GB = 5,000,000,000; the 75 KB floor is treated as 76,800 bytes). LinkedIn does not state binary or decimal, so PreflightQC uses the conservative reading and never passes a file LinkedIn would reject.",
  "caveats": [
    "LinkedIn explicitly no longer supports AVI, QuickTime or MOV for organic native video. A MOV master must be re-wrapped before posting.",
    "LinkedIn's own pages disagree about maximum duration: the specification page says 10 minutes, the troubleshooting page says 15 minutes from desktop and 10 from mobile. PreflightQC warns between 10 and 15 minutes and only fails above 15.",
    "LinkedIn documents nothing about audio requirements, colour, HDR, interlacing or variable frame rate for organic video. Those are reported, never judged.",
    "Organic and advertising specifications are different products and must never be merged."
  ],
  "sources": [
    {
      "source_ref": "L-S1",
      "title": "Video specifications for your LinkedIn Pages and Career Pages",
      "url": "https://www.linkedin.com/help/linkedin/answer/a1311816",
